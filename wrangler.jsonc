{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nav",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "alias": {
    "undici": "./worker/no-proxy.mjs"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FEED_STORE",
        "class_name": "NavFeedStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NavFeedStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "vars": {
    "TRANSLATION_PROVIDER": "workers-ai",
    "TRANSLATION_MODEL": "@cf/zai-org/glm-4.7-flash",
    "TRANSLATION_FORMAT": "numbered",
    "TRANSLATION_BATCH_SIZE": "16",
    "TRANSLATION_CHUNK_SIZE": "16",
    "TRANSLATION_DAILY_LIMIT": "1000",
    "TRANSLATION_AI_DAILY_NEURONS": "8000"
  },
  "routes": [
    {
      "pattern": "nav.zhichoo.com",
      "custom_domain": true
    }
  ]
}
