# Opt-in translation. Public titles are sent to your selected provider and may incur charges.
# OpenAI-compatible chat/completions endpoint; credentials stay on the server.
TRANSLATION_PROVIDER=openai
TRANSLATION_BASE_URL=https://tokenhub.tencentmaas.com/v1
TRANSLATION_MODEL=hy-mt2-pro
TRANSLATION_API_KEY=
# numbered: translation-specialized models (HY-MT); json: general chat models.
TRANSLATION_FORMAT=numbered
# At most 128 new unique titles per refresh, split into bounded serial chunks.
TRANSLATION_BATCH_SIZE=128
TRANSLATION_CHUNK_SIZE=16
TRANSLATION_INTERVAL_MS=1000
# Optional alternative: set TRANSLATION_PROVIDER=deeplx and paste a private HTTPS URL.
DEEPLX_URL=
DEEPLX_CHUNK_SIZE=8
DEEPLX_INTERVAL_MS=1500
PORT=4318
HOST=127.0.0.1

# RSS only: direct request first, retry with your existing HTTP(S) proxy on failure.
# Does not change translation traffic or system proxy settings. Leave blank to disable.
FEED_PROXY_URL=http://127.0.0.1:7890
