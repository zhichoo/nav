{
  "name": "signal-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc -b && node --test tests/*.test.mjs",
    "feeds:check": "node scripts/check-feeds.mjs",
    "cf:dev": "npm run build && wrangler dev --test-scheduled",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/build",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
